{
    "version": "2.0.0",
    // Godot 4.7.2 binary, installed via the Godots version manager (Flatpak).
    // ${env:HOME} keeps this file portable across machines/username changes.
    // All Godot tasks target the project root: ${workspaceFolder}/godot.
    "tasks": [
        {
            "label": "streamslop: run game",
            "detail": "Launch the game in a window, no debugger. For debugging use a launch configuration instead.",
            "type": "shell",
            "command": "${env:HOME}/.var/app/io.github.MakovWait.Godots/data/godot/app_userdata/Godots/versions/Godot_v4_7_2-stable_linux_x86_64/Godot_v4.7.2-stable_linux.x86_64",
            "args": [
                "--path",
                "${workspaceFolder}/godot"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "streamslop: Godot class rescan (headless)",
            "detail": "Regenerate the class cache after adding/moving scripts with class_name. Run before headless runs or they lie.",
            "type": "shell",
            "command": "${env:HOME}/.var/app/io.github.MakovWait.Godots/data/godot/app_userdata/Godots/versions/Godot_v4_7_2-stable_linux_x86_64/Godot_v4.7.2-stable_linux.x86_64",
            "args": [
                "--headless",
                "--editor",
                "--quit",
                "--path",
                "${workspaceFolder}/godot"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "streamslop: attribution lint",
            "detail": "tools/attr_lint.py: exit 0 = every asset file under godot/assets/ is credited in catalog.json.",
            "type": "shell",
            "command": "python3",
            "args": [
                "tools/attr_lint.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            },
            "problemMatcher": []
        }
    ]
}
